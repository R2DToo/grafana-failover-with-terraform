      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "# the inner query is going to produce a non-zero value if there was at least one successful check during the 5 minute window\r\n        # so make it a 1 if there was at least one success and a 0 otherwise\r\n        ceil(\r\n          # the number of successes across all probes\r\n          sum by (instance, job) (increase(probe_all_success_sum{job=`${job}`}[$__rate_interval]))\r\n          /\r\n          # the total number of times we checked across all probes\r\n          (sum by (instance, job) (increase(probe_all_success_count{job=`${job}`}[$__rate_interval])) + 1) # + 1 because we want to make sure it goes to 1, not 2\r\n        )",
          "instant": false,
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Uptime",
      "type": "stat"

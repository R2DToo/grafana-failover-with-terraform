        "enable": true,
        "expr": "{job=\"ivr-master-logs\"} | regexp `[^,]+,[^,]+,(?P<RESULT>[^,]+),[^,]*,[^,]*,(?P<JOB_NAME>[^,]+),[^,]+,[^,]+,[^,]*,[^,]+,(?P<EXPECTED>[^,]+),(?P<ACTUAL>.+)` | RESULT = \"FAILURE\" | JOB_NAME =~ `$Statuses` | drop filename, job, service_name",

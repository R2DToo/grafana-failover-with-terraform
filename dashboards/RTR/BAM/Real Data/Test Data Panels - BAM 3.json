          },
          "displayMode": "detect",
          "index": "select index",
          "metricAggs": [
            {
              "alias": "",
              "field": "select field",
              "func": "avg"
            }
          ],
          "options": {
            "cont": true,
            "partial": true
          },
          "query": "index=\"index_${env}_exch_k8s\" kubernetes.container_name=\"rtr-heartbeat-outbound-api-${env}\" level=info message=\"*.interac.rtr.heartbeat.service.MetricLoggingService*\"\n| rex field=_raw \"ca.interac.rtr.heartbeat.service.MetricLoggingService - (?<status>.*?) \"\n| rex field=_raw \"participant=(?<participant>\\w+)\"\n| stats count by status, participant",
          "rawQuery": true,
          "refId": "A",
          "sourcetype": "select sourcetype",
          "splitByFields": [],
          "tcOptions": {
            "nullstr": "",
            "otherstr": "",
            "span": "auto",
            "usenull": false,
            "useother": true
          },
          "whereClause": {
            "value": ""
          }
        }
      ],
      "title": "BAM3-W1-Heartbeat Failure Percentage: Sent from Exchange ",
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "status",
            "rowField": "participant",
            "valueField": "count"
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "reduceRow",
            "reduce": {
              "include": [
                "Failed",
                "Success"
              ],
              "reducer": "sum"
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "binary": {
              "left": {
                "matcher": {
                  "id": "byName",
                  "options": "Failed"
                }
              },
              "operator": "/",
              "right": {
                "matcher": {
                  "id": "byName",
                  "options": "Total"
                }
              }
            },
            "mode": "binary",
            "reduce": {
              "reducer": "sum"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Failed": true,
              "Success": true,
              "Total": true
            },
            "includeByName": {},
            "indexByName": {},
            "renameByName": {
              "Failed / Total": "Failure Percentage",
              "participant\\status": "Participant"
            }
          }
        },
        {
          "id": "rowsToFields",
          "options": {
            "mappings": [
              {
                "fieldName": "Participant",
                "handlerKey": "field.name"
              },
              {
                "fieldName": "Failure Percentage",
                "handlerKey": "field.value"
              }
            ]
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "(.*)",
            "renamePattern": "$1-outbound"
          }
        }
      ],
      "type": "stat"
    },

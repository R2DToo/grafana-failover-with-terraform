                },
                "1": {
                  "color": "light-green",
                  "index": 2,
                  "text": "Starting"
                },
                "2": {
                  "color": "green",
                  "index": 3,
                  "text": "Running"
                },
                "3": {
                  "index": 4,
                  "text": "Quiescing"
                },
                "4": {
                  "color": "light-red",
                  "index": 5,
                  "text": "Stopping"
                },
                "5": {
                  "color": "yellow",
                  "index": 6,
                  "text": "Standby"
                },
                "-1": {
                  "color": "dark-red",
                  "index": 0,
                  "text": "N/A"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]

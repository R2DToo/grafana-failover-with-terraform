          "id": "calculateField",
          "options": {
            "alias": "Error Percentage",
            "binary": {
              "left": "Total Errors",
              "operator": "/",
              "right": "Total Calls"
            },
            "mode": "binary",
            "reduce": {
              "include": [
                "200"
              ],
              "reducer": "sum"
            },
            "replaceFields": true
          }
        }
      ],

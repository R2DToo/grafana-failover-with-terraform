      "description": "Shows if metrics are being received for the selected time range.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "text",
            "mode": "fixed"
          },
          "mappings": [
            {
              "options": {
                "match": "null",
                "result": {
                  "color": "light-red",
                  "index": 0,
                  "text": "No metrics received - Check configuration"
                }
              },
              "type": "special"
            },
            {
              "options": {
                "from": 0,
                "result": {
                  "color": "light-red",
                  "index": 1,
                  "text": "Failed to collect metrics"
                },
                "to": 0
              },
              "type": "range"
            },
            {
              "options": {
                "from": 1,
                "result": {
                  "color": "light-green",
                  "index": 2,
                  "text": "Receiving metrics"
                },
                "to": 1000000

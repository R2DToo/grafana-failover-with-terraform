          "datasource": {
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "sum(aws_apigateway_4xx_sum{job=~\"$job\", account_id=~\"$account_id\", region=~\"$region\", dimension_ApiId=~\"$instance\"})",
          "legendFormat": "4XX Error Sum",
          "range": true,
          "refId": "e4xx"
        },
        {
          "datasource": {
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "sum(aws_apigateway_5xx_sum{job=~\"$job\", account_id=~\"$account_id\", region=~\"$region\", dimension_ApiId=~\"$instance\"})",
          "legendFormat": "5XX Error Sum",
          "range": true,
          "refId": "e5xx"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "sum(aws_apigateway_count_sum{job=~\"$job\", account_id=~\"$account_id\", region=~\"$region\", dimension_ApiId=~\"$instance\"})",
          "hide": true,
          "instant": false,
          "legendFormat": "__auto",
          "range": true,
          "refId": "count"
        },
        {
          "datasource": {
            "name": "Expression",
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "($e4xx+$e5xx)*100/$count",
          "hide": false,
          "refId": "Total Error Rate",
          "type": "math"
        }
      ],
      "title": "4XXError / 5XXError",
      "type": "timeseries"

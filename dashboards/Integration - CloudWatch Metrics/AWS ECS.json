  "id": 80,
  "panels": [
    {
      "content": "Showing metrics only for AWS ECS clusters and tasks that have tags assigned to them. For more information, see [Amazon ECS CloudWatch metrics](https://docs.aws.amazon.com/AmazonECS/latest/developerguide/cloudwatch-metrics.html).\n",
      "datasource": "default",

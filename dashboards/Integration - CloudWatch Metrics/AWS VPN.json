      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "disableTextWrap": false,
          "editorMode": "code",
          "expr": "sum by(name) (aws_vpn_tunnel_state_maximum{region=~\"$region\", name!=\"global\"})",
          "format": "time_series",
          "fullMetaSearch": false,
          "includeNullMetadata": true,
          "instant": false,
          "legendFormat": "{{ name }}",
          "range": true,
          "refId": "A",

{
  "description": "Visualize Amazon S3 metrics",
  "editable": false,
  "graphTooltip": 1,
  "id": 85,
  "panels": [
    {
      "content": "Showing metrics only for AWS resources that have tags assigned to them. For more information, see [Amazon CloudWatch Metrics for Amazon S3](https://docs.aws.amazon.com/AmazonS3/latest/userguide/metrics-dimensions.html).\n",
      "datasource": "default",
      "gridPos": {
        "h": 3,
        "w": 24
      },
      "id": 2,
      "mode": "markdown",
      "title": "Info",
      "transparent": false,
      "type": "text"
    },
    {
      "datasource": "$datasource",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "absolute"
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 3
      },
      "id": 3,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "$datasource",
          "expr": "sum(last_over_time(aws_s3_number_of_objects_average{scrape_job=~\"$job\"}[1d]) > 0)",
          "format": "time_series"
        }
      ],
      "title": "Total number of objects",
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": "$datasource",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "absolute"
          },
          "unit": "bytes"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 3
      },
      "id": 4,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "$datasource",
          "expr": "sum(last_over_time(aws_s3_bucket_size_bytes_average{scrape_job=~\"$job\"}[1d]) > 0)",
          "format": "time_series"
        }
      ],
      "title": "Total buckets size",
      "transparent": false,
      "type": "stat"
    },
    {
      "bars": false,
      "dashLength": 10,
      "dashes": false,
      "datasource": "$datasource",
      "fill": 1,
      "fillGradient": 0,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "hiddenSeries": false,
      "id": 5,
      "lines": true,
      "linewidth": 1,
      "nullPointMode": "null",
      "percentage": false,
      "points": false,
      "renderer": "flot",
      "spaceLength": 10,
      "stack": false,
      "steppedLine": false,
      "targets": [
        {
          "datasource": "$datasource",
          "expr": "last_over_time(aws_s3_number_of_objects_average{scrape_job=~\"$job\", region=~\"$region\", dimension_BucketName=~\"$bucket\"}[1d])",
          "format": "time_series",
          "legendFormat": "{{dimension_BucketName}}"
        }
      ],
      "title": "Number of objects",
      "tooltip": {
        "value_type": "individual"
      },
      "transparent": false,
      "type": "graph",
      "yaxes": [
        {
          "decimals": 0,
          "format": "short",
          "logBase": 1,
          "min": 0,
          "show": true
        },
        {
          "format": "short",
          "logBase": 1,
          "show": true
        }
      ]
    },
    {
      "bars": false,
      "dashLength": 10,
      "dashes": false,
      "datasource": "$datasource",
      "fill": 1,
      "fillGradient": 0,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "hiddenSeries": false,
      "id": 6,
      "lines": true,
      "linewidth": 1,
      "nullPointMode": "null",
      "percentage": false,
      "points": false,
      "renderer": "flot",
      "spaceLength": 10,
      "stack": false,
      "steppedLine": false,
      "targets": [
        {
          "datasource": "$datasource",
          "expr": "last_over_time(aws_s3_bucket_size_bytes_average{scrape_job=~\"$job\", region=~\"$region\", dimension_BucketName=~\"$bucket\"}[1d])",
          "format": "time_series",
          "legendFormat": "{{dimension_BucketName}}"
        }
      ],
      "title": "Bucket size",
      "tooltip": {
        "value_type": "individual"
      },
      "transparent": false,
      "type": "graph",
      "yaxes": [
        {
          "format": "bytes",
          "logBase": 1,
          "min": 0,
          "show": true
        },
        {
          "format": "short",
          "logBase": 1,
          "show": true
        }
      ]
    },
    {
      "collapse": true,
      "collapsed": true,
      "datasource": "$datasource",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "id": 7,
      "panels": [
        {
          "content": "Enable [Requests metrics](https://docs.aws.amazon.com/AmazonS3/latest/userguide/cloudwatch-monitoring.html) from the AWS console and create a Filter to make sure your requests metrics are reported.\n",
          "datasource": "default",
          "gridPos": {
            "h": 2,
            "w": 24,
            "x": 0,
            "y": 16
          },
          "id": 8,
          "mode": "markdown",
          "title": "Info",
          "transparent": false,
          "type": "text"
        },
        {
          "bars": false,
          "dashLength": 10,
          "dashes": false,
          "datasource": "$datasource",
          "fill": 1,
          "fillGradient": 0,
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 18
          },
          "hiddenSeries": false,
          "id": 9,
          "lines": true,
          "linewidth": 1,
          "nullPointMode": "null",
          "percentage": false,
          "points": false,
          "renderer": "flot",
          "spaceLength": 10,
          "stack": false,
          "steppedLine": false,
          "targets": [
            {
              "datasource": "$datasource",
              "expr": "rate(aws_s3_total_request_latency_p95{scrape_job=~\"$job\", region=~\"$region\", dimension_BucketName=~\"$bucket\", dimension_FilterId=~\"$filter_id\"}[2h]) * 1e3",
              "format": "time_series",
              "legendFormat": "{{dimension_BucketName}}"
            }
          ],
          "title": "Request latency (p95)",
          "tooltip": {
            "value_type": "individual"
          },
          "transparent": false,
          "type": "graph",
          "yaxes": [
            {
              "decimals": 1,
              "format": "ms",
              "logBase": 1,
              "min": 0,
              "show": true
            },
            {
              "format": "short",
              "logBase": 1,
              "show": true
            }
          ]
        },
        {
          "bars": false,
          "dashLength": 10,
          "dashes": false,
          "datasource": "$datasource",
          "fill": 1,
          "fillGradient": 0,
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 18
          },
          "hiddenSeries": false,
          "id": 10,
          "lines": true,
          "linewidth": 1,
          "nullPointMode": "null",
          "percentage": false,
          "points": false,
          "renderer": "flot",
          "spaceLength": 10,
          "stack": false,
          "steppedLine": false,
          "targets": [
            {
              "datasource": "$datasource",
              "expr": "aws_s3_4xx_errors_sum{scrape_job=~\"$job\", region=~\"$region\", dimension_BucketName=~\"$bucket\", dimension_FilterId=~\"$filter_id\"}",
              "format": "time_series",
              "legendFormat": "{{dimension_BucketName}}"
            }
          ],
          "title": "Errors count",
          "tooltip": {
            "value_type": "individual"
          },
          "transparent": false,
          "type": "graph",
          "yaxes": [
            {
              "decimals": 0,
              "format": "short",
              "logBase": 1,
              "min": 0,
              "show": true
            },
            {
              "format": "short",
              "logBase": 1,
              "show": true
            }
          ]
        }
      ],
      "showTitle": true,
      "title": "Request metrics",
      "titleSize": "h6",
      "type": "row"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 25,
  "style": "dark",
  "tags": [
    "cloudwatch-integration"
  ],
  "templating": {
    "list": [
      {
        "hide": 0,
        "includeAll": false,
        "label": "Data Source",
        "multi": false,
        "name": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "regex": "(?!grafanacloud-usage|grafanacloud-ml-metrics).+",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "allValue": ".+",
        "datasource": "$datasource",
        "hide": 0,
        "includeAll": true,
        "label": "job",
        "multi": true,
        "name": "job",
        "query": "label_values(aws_s3_info, scrape_job)",
        "refresh": 2,
        "skipUrlSync": false,
        "sort": 1,
        "type": "query",
        "useTags": false
      },
      {
        "datasource": "$datasource",
        "hide": 0,
        "includeAll": true,
        "label": "Region",
        "multi": true,
        "name": "region",
        "query": "label_values(aws_s3_number_of_objects_average, region)",
        "refresh": 2,
        "skipUrlSync": false,
        "sort": 1,
        "type": "query",
        "useTags": false
      },
      {
        "datasource": "$datasource",
        "hide": 0,
        "includeAll": true,
        "label": "Bucket",
        "multi": true,
        "name": "bucket",
        "query": "label_values(aws_s3_number_of_objects_average, dimension_BucketName)",
        "refresh": 2,
        "skipUrlSync": false,
        "sort": 1,
        "type": "query",
        "useTags": false
      },
      {
        "datasource": "$datasource",
        "hide": 0,
        "includeAll": true,
        "label": "FilterId",
        "multi": true,
        "name": "filter_id",
        "query": "label_values(aws_s3_all_requests_sum{dimension_BucketName=~\"$bucket\"}, dimension_FilterId)",
        "refresh": 2,
        "skipUrlSync": false,
        "sort": 1,
        "type": "query",
        "useTags": false
      }
    ]
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "title": "AWS S3",
  "uid": "8d33f177d36ba927264e63253395f212",
  "version": 1
}
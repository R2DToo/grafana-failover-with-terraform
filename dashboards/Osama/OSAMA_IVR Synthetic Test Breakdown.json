      {
        "datasource": {
          "type": "loki",
          "uid": "grafanacloud-logs"
        },
        "enable": true,
        "expr": "{job=\"ivr-master-logs\"} | regexp `[^,]+,[^,]+,(?P<RESULT>[^,]+),[^,]*,[^,]*,(?P<JOB_NAME>[^,]+),[^,]+,[^,]+,[^,]*,[^,]+,(?P<EXPECTED>[^,]+),(?P<ACTUAL>.+)` | RESULT = \"FAILURE\" | JOB_NAME =~ `$Statuses` | drop filename, job, service_name",
        "filter": {
          "exclude": false,
          "ids": [
            8
          ]
        },
        "hide": false,
        "iconColor": "red",
        "instant": false,
        "name": "Test Failure",
        "textFormat": "Expected: ({{EXPECTED}}) != Actual: ({{ACTUAL}})",
        "titleFormat": "Test Failure"
      }
    ]
  },
